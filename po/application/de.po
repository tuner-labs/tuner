msgstr ""
"Schnelles Durchwechseln der Metadaten des wiedergegebenen Streams, falls "
"Streaminfo aktiviert ist"

#: src/Widgets/PreferencesPopover.vala:96
msgid "Stream metadata image popup"
msgstr "Metadaten-Bild-Popup"

